DATABASE_URL="postgresql://bondlab:bondlab@127.0.0.1:54329/bondlab"

# Google sign-in: put real values in ignored .env.local, never commit them.
BETTER_AUTH_URL="http://localhost:3000"
BETTER_AUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Exact approved Google Workspace domains, comma-separated. Server-only.
# Set real domains in ignored .env.local / private hosting settings.
# Documentation and tests use school.example,academy.example as fictional examples.
# Empty means no school domains are allowed; explicit private exceptions still apply.
AUTH_SCHOOL_DOMAINS=""

# Optional private, comma-separated Google account exceptions. Server-only.
AUTH_ALLOWED_EMAILS=""
